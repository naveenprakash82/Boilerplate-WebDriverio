{
  "name": "web-test-reliability-examples",
  "version": "1.1.0",
  "private": true,
  "description": "Browser automation and reproducible test reliability examples",
  "scripts": {
    "test": "wdio run ./wdio.conf.js",
    "test:smoke": "wdio run ./wdio.conf.js --mochaOpts.grep smoke",
    "test:unit": "node --test test/unit/*.test.js",
    "analyze": "node src/reliability/cli.js",
    "check": "node scripts/check.js",
    "jest:convert": "node src/reliability/jestJsonCli.js",
    "playwright:convert": "node src/reliability/playwrightJsonCli.js",
    "prioritize": "node src/reliability/priorityCli.js",
    "analyze:batch": "node src/reliability/batchCli.js"
  },
  "devDependencies": {
    "@wdio/cli": "^9.0.0",
    "@wdio/local-runner": "^9.0.0",
    "@wdio/mocha-framework": "^9.0.0",
    "@wdio/spec-reporter": "^9.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
